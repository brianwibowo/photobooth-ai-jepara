# Keep this file server-side only. Never expose the key in Vite client variables.
GEMINI_API_KEY=isi_api_key_gemini_di_sini
GEMINI_MODEL=gemini-nano-banana-2.1
# OpenRouter API (Alternative provider with multi-model fallback chain)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-image-2.5-flare
AI_INFOGRAPHIC_MODEL=openai/gpt-image-2.5-flare
ALLOW_LOCAL_FALLBACK=false
ADMIN_TOKEN=
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
MAX_UPLOAD_MB=8
# QR/download token TTL and server-side result retention (milliseconds).
# Set RESULT_RETENTION_MS=0 to retain results until manual cleanup.
DOWNLOAD_TTL_MS=60000
RESULT_RETENTION_MS=604800000

# Optional photo email. Credentials stay only on the VPS; never use VITE_* here.
# EMAIL_FROM must be an address permitted/verified by the SMTP provider.
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_FROM_NAME="Museum R.A. Kartini"
SMTP_HOST=
# 587 + STARTTLS: SMTP_SECURE=false; 465 + implicit TLS: SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Maximum new recipient requests in a rolling 24-hour period.
EMAIL_DAILY_LIMIT=200
