{$DOMAIN:photobooth-jepara.duckdns.org} {
    # DNS-01 avoids ports 80/443, which are already owned by another VPS service.
    # DUCKDNS_API_TOKEN is injected by Compose and never stored in this file.
    tls {
        dns duckdns {env.DUCKDNS_API_TOKEN}
    }
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    }
    # Allow the 8 MB photo plus multipart form overhead.
    request_body {
        max_size 10MB
    }
    reverse_proxy app:8787
}
