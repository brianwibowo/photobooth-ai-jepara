# Allowlist: no secrets, visitor data, Git metadata, or large source library.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!index.html
!vite.config.js
!src/
!src/**
!server/
!server/**
!scripts/
!scripts/check-assets.mjs
!public/
!public/**
# Only active production assets live in public; raw revision sources stay
# outside this allowlist and are not needed by the Docker build.
public/assets/**/.DS_Store
