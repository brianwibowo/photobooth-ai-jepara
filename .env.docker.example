DOMAIN=photobooth-jepara.duckdns.org
# Host ports. Ports 80 and 443 are already used by another service on this VPS.
HTTP_PORT=8080
HTTPS_PORT=8443
PUBLIC_BASE_URL=https://photobooth-jepara.duckdns.org:8443
# Fill on the VPS; never commit the real .env or put the key in a Dockerfile.
GEMINI_API_KEY=
DUCKDNS_API_TOKEN=
# Supported image model; override for another model enabled in your account.
GEMINI_MODEL=gemini-nano-banana-2.1
# OpenRouter API (Alternative provider with multi-model fallback chain)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-image-2.5-sunburst
AI_INFOGRAPHIC_MODEL=openai/gpt-image-2.5-sunburst
ALLOW_LOCAL_FALLBACK=false
# QR/download token is intentionally short; result files remain for 7 days.
# Set RESULT_RETENTION_MS=0 to retain results until manual cleanup.
DOWNLOAD_TTL_MS=60000
RESULT_RETENTION_MS=604800000
# Optional: protects GET /api/admin/guests.csv (generate with `openssl rand -hex 32`).
ADMIN_TOKEN=
